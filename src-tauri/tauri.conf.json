{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Budget Perso",
  "version": "1.1.1",
  "identifier": "com.eric.budgetperso",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Budget Perso",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:budget.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2OEIzMzZEMERERjY2MQpSV1JoOXQzUU5yTm9BYnRCZWxmci9jOElrRm9iRmlrN2l0c2MzNU9HYlNmWlRTSVhjRk1DWjJqQgo=",
      "endpoints": [
        "https://github.com/ERIC96-lang/budget-perso/releases/latest/download/latest.json"
      ]
    }
  }
}
